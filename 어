<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Phone mockup - tap to change screen</title>
<style>
  :root{--phone-w:360px;--phone-h:780px}
  body{min-height:100vh;display:flex;align-items:center;justify-content:center;margin:0;background:#eef2f6;font-family:system-ui,-apple-system,Segoe UI,Roboto}
  .phone{
    width:var(--phone-w);height:var(--phone-h);
    border-radius:44px;background:#111;padding:14px;box-sizing:border-box;
    box-shadow:0 20px 40px rgba(0,0,0,0.25);
    position:relative;overflow:visible;
  }
  .notch{position:absolute;left:50%;transform:translateX(-50%);top:12px;width:140px;height:28px;background:#111;border-radius:14px;z-index:3}
  .screen{
    width:100%;height:100%;background:#fff;border-radius:28px;overflow:hidden;position:relative;
    display:flex;align-items:center;justify-content:center;touch-action:pan-y;
  }

  /* 화면 이미지(또는 iframe) */
  .screen img, .screen iframe{
    width:100%;height:100%;object-fit:cover;border:0;display:block;
    transition:opacity 300ms ease, transform 300ms ease;
  }
  .screen .slide{
    position:absolute;inset:0;opacity:0;transform:scale(1.02);
    pointer-events:none;
  }
  .screen .slide.active{opacity:1;transform:scale(1);pointer-events:auto}

  /* 하단 버튼(선택/홈 등) */
  .controls{
    position:absolute;left:50%;transform:translateX(-50%);bottom:10px;z-index:4;display:flex;gap:8px;
  }
  .dot{width:10px;height:10px;border-radius:999px;background:rgba(255,255,255,0.6);opacity:0.6}
  .dot.active{background:#fff;opacity:1;box-shadow:0 0 0 6px rgba(255,255,255,0.06) inset;}
  /* UX: 클릭 가능한 영역 전체 */
  .tap-layer{position:absolute;inset:0;z-index:5;background:transparent}
  @media (max-width:420px){ .phone{transform:scale(0.8);transform-origin:center top} }
</style>
</head>
<body>
  <div class="phone" role="application" aria-label="Phone mockup">
    <div class="notch" aria-hidden="true"></div>

    <div class="screen" id="screen">
      <!-- 여러 스크린 이미지 (slide 요소) -->
      <img src="screen1.png" class="slide active" alt="screen 1">
      <img src="screen2.png" class="slide" alt="screen 2">
      <img src="screen3.png" class="slide" alt="screen 3">

      <!-- 탭/스와이프 영역 (터치/클릭 처리) -->
      <div class="tap-layer" id="tapLayer" role="button" aria-label="Tap to change screen"></div>
    </div>

    <div class="controls" id="dots"></div>
  </div>

<script>
  // 화면들 배열은 DOM에서 .slide를 읽어 자동으로 구성
  const slides = Array.from(document.querySelectorAll('.screen .slide'));
  const dotsWrap = document.getElementById('dots');
  let idx = 0;

  // 점(dots) 만들기
  slides.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'dot' + (i===0 ? ' active' : '');
    d.dataset.index = i;
    d.style.cursor = 'pointer';
    d.addEventListener('click', (e)=>goTo(parseInt(e.currentTarget.dataset.index)));
    dotsWrap.appendChild(d);
  });

  function update() {
    slides.forEach((s,i)=> s.classList.toggle('active', i===idx));
    Array.from(dotsWrap.children).forEach((d,i)=> d.classList.toggle('active', i===idx));
  }

  function goTo(i){
    idx = (i + slides.length) % slides.length;
    update();
  }

  function next(){
    goTo(idx + 1);
  }

  // 클릭/탭: 화면을 탭하면 다음 화면으로
  const tapLayer = document.getElementById('tapLayer');
  tapLayer.addEventListener('click', next);

  // 간단한 스와이프 (터치) 지원
  let startX = null;
  tapLayer.addEventListener('touchstart', (e)=> {
    if(e.touches && e.touches[0]) startX = e.touches[0].clientX;
  }, {passive:true});
  tapLayer.addEventListener('touchend', (e)=> {
    if(startX == null) return;
    const endX = (e.changedTouches && e.changedTouches[0]) ? e.changedTouches[0].clientX : null;
    if(endX == null) { startX = null; return; }
    const dx = endX - startX;
    if(Math.abs(dx) > 40){
      if(dx < 0) goTo(idx+1); else goTo(idx-1);
    }
    startX = null;
  });

  // 키보드 네비게이션 (선택적)
  window.addEventListener('keydown', (e)=>{
    if(e.key === 'ArrowRight') goTo(idx+1);
    else if(e.key === 'ArrowLeft') goTo(idx-1);
  });

  // 만약 라이브 페이지 미리보기가 필요하면 아래처럼 이미지 대신 iframe을 사용:
  // <iframe src="https://example.com" class="slide active" sandbox="allow-scripts allow-same-origin"></iframe>
  // 여러 src를 바꾸려면 slides 대신 src 배열로 iframe.src = srcs[idx];
  // 주의: iframe은 target 서버의 X-Frame-Options/CSP에 의해 차단될 수 있습니다.
</script>
</body>
</html>